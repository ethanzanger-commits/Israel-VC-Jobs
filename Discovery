-- Auto-discovery add-on. Run ONCE in Supabase > SQL Editor if you already ran setup.sql (a fresh setup.sql already includes it).
create table if not exists discovery_targets (
  id uuid primary key default gen_random_uuid(),
  vc_firm_id uuid not null references vc_firms(id) on delete cascade,
  kind text not null check (kind in ('vc_site','company_site')),
  url text not null, evidence_url text, cap int,
  status text not null default 'pending' check (status in ('pending','working','done','no_board','failed','skipped')),
  note text, attempts int not null default 0,
  created_at timestamptz not null default now(), updated_at timestamptz not null default now(),
  unique (vc_firm_id, url)
);
create index if not exists discovery_pending on discovery_targets (status, kind, created_at);
alter table discovery_targets enable row level security;
revoke all on discovery_targets from anon, authenticated;

